{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-context.mjs",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-tool-gate.mjs",
        "matcher": "Write|Edit|StrReplace|Delete|MultiEdit",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node .cursor/hooks/constraints-guard.mjs",
        "matcher": "Write|Edit|StrReplace|Delete|MultiEdit",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell.mjs",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/before-read.mjs",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-tool-scan.mjs",
        "matcher": "Write|Edit|StrReplace|MultiEdit",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/subagent-gate.mjs",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-evidence.mjs",
        "failClosed": false,
        "timeout": 10,
        "loop_limit": 8
      }
    ]
  }
}
