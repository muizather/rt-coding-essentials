{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./scripts/session-context.mjs",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "node ./scripts/pre-tool-gate.mjs",
        "matcher": "Write|Edit|StrReplace|Delete|MultiEdit",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "node ./scripts/constraints-guard.mjs",
        "matcher": "Write|Edit|StrReplace|Delete|MultiEdit",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./scripts/before-shell.mjs",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": "node ./scripts/before-read.mjs",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node ./scripts/post-tool-scan.mjs",
        "matcher": "Write|Edit|StrReplace|MultiEdit",
        "failClosed": false,
        "timeout": 30
      }
    ],
    "subagentStart": [
      {
        "command": "node ./scripts/subagent-gate.mjs",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node ./scripts/stop-evidence.mjs",
        "failClosed": false,
        "timeout": 10,
        "loop_limit": 8
      }
    ]
  }
}
